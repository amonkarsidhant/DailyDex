FROM node:20-slim

# Chromium for Remotion headless rendering, ffmpeg for audio/video muxing
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       chromium \
       ffmpeg \
       espeak-ng \
       python3 \
       python3-pip \
       ca-certificates \
       fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/*

# Tell Remotion to use the system Chromium instead of downloading its own
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
ENV REMOTION_BROWSER_EXECUTABLE=/usr/bin/chromium

WORKDIR /app

COPY requirements.txt ./
RUN pip3 install --break-system-packages --no-cache-dir -r requirements.txt

COPY src ./src
COPY config.json ./
COPY config ./config

WORKDIR /engine

# Install deps first (cache layer)
COPY video-engine/package.json video-engine/package-lock.json ./
RUN npm ci --omit=dev

# Copy the Remotion source
COPY video-engine/src ./src
COPY video-engine/remotion.config.ts ./
COPY video-engine/tsconfig.json ./

# Copy static assets (bg music, images)
COPY video-engine/public ./public

# Render output lands here; the Flask container reads from the shared volume
RUN mkdir -p /output

ENV PYTHONPATH=/app/src
ENV DATA_DIR=/app/data
ENV DB_PATH=/app/data/intelligence.db
ENV SCORED_DATA_FILE=/app/data/data_scored.json
ENV DAILYDEX_SETTINGS_DIR=/app/data/settings
ENV CREATOR_PROFILE_PATH=/app/data/creator_profile.json
ENV VIDEO_ENGINE_DIR=/engine

CMD ["python3", "/app/src/render_worker.py"]

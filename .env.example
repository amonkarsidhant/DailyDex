# ============================================================
# DailyDex — Environment configuration template
# Copy to .env and fill in your values. NEVER commit .env.
# ============================================================

# ── Web Authentication (required for public/VPS deployments) ────────────────
DAILYDEX_AUTH_ENABLED=1
# Generate with: openssl rand -hex 32
FLASK_SECRET_KEY=
# One-time code required to create the first and only workspace account.
# Generate with: openssl rand -base64 24
AUTH_INVITE_CODE=
AUTH_ALLOW_SIGNUP=1
AUTH_SESSION_HOURS=12
SESSION_COOKIE_SECURE=1
AUTH_TRUST_PROXY_HEADERS=1
DAILYDEX_ALLOWED_HOSTS=your-domain.example
PUBLIC_BASE_URL=https://your-domain.example
# Disabled by default in production because it can expose source files.
CODE_GRAPH_ENABLED=0

# ── Billing (Stripe hosted checkout) ────────────────────────────────────────
DAILYDEX_BILLING_ENABLED=0
BILLING_TRIAL_DAYS=14
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_CREATOR_PRICE_ID=
STRIPE_STUDIO_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# ── LLM Provider ────────────────────────────────────────────────────────────
# Options: nvidia, openai, anthropic, ollama, gemini, opencode, claude, kilocode
LLM_PROVIDER=nvidia

# NVIDIA NIM (free tier available)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
# NIM enforces a per-account concurrency ceiling and returns
# "ResourceExhausted: Worker local total request limit reached" past it.
# This caps concurrent calls per process — lower it when the web and
# orchestrator containers share one account, raise it on a paid tier.
NVIDIA_MAX_CONCURRENCY=2
# Throttled and transient 5xx calls retry with jittered backoff. 0 disables.
NVIDIA_MAX_RETRIES=5
# A 70B model writing a full creator pack needs well over the old 60s ceiling.
NVIDIA_TIMEOUT=180
# 429 is a per-minute quota, so it backs off on that scale rather than seconds.
NVIDIA_RATE_LIMIT_BASE=8

# OpenAI (if using openai provider)
# OPENAI_API_KEY=

# Anthropic (if using anthropic provider)
# ANTHROPIC_API_KEY=

# Ollama (if using ollama provider — local)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3

# ── Notion Integration ──────────────────────────────────────────────────────
NOTION_API_TOKEN=
NOTION_DATABASE_ID=

# ── Telegram Bot (optional) ─────────────────────────────────────────────────
# TELEGRAM_BOT_TOKEN=

# ── YouTube OAuth (optional, for video uploads) ─────────────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8888/api/integrations/youtube/callback

# ── ElevenLabs (optional, for voiceover) ────────────────────────────────────
# ELEVENLABS_API_KEY=

# ── GitHub API (optional; scraper fallback remains available) ───────────────
# GITHUB_TOKEN=

# ── Orchestrator Settings ───────────────────────────────────────────────────
ORCH_FETCH_INTERVAL=7200
ORCH_STUDIO_INTERVAL=21600
ORCH_TOP_N=3
ORCH_NOTION_SYNC=1

# ── Database ────────────────────────────────────────────────────────────────
# Leave empty for SQLite (default). Set for Postgres/Supabase.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ── Enrichment ──────────────────────────────────────────────────────────────
CREATOR_ENRICH_DAILY_LIMIT=60
CREATOR_ENRICHER_PRIMARY=1

# Vercel cron endpoints (not used by the Docker orchestrator)
# CRON_SECRET=
